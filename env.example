# Environment Variables for Secure M-Pesa System
# Copy this file to .env.local for development

# Development Settings
REACT_APP_ENV=development
REACT_APP_VERSION=1.0.0

# Demo/Test Settings
REACT_APP_DEMO_MODE=true
REACT_APP_TEST_PHONE_NUMBER=+254759075816

# Future Production Settings (when backend is ready)
# REACT_APP_MPESA_CONSUMER_KEY=your_consumer_key_here
# REACT_APP_MPESA_CONSUMER_SECRET=your_consumer_secret_here
# REACT_APP_MPESA_SHORTCODE=your_shortcode_here
# REACT_APP_MPESA_PASSKEY=your_passkey_here
# REACT_APP_BACKEND_URL=https://api.yourdomain.com

# Security Settings
REACT_APP_ENCRYPTION_KEY=demo_encryption_key_not_for_production
REACT_APP_SESSION_TIMEOUT=3600000
